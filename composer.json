{
    "name": "nexah/sms-tracer",
    "description": "API de collecte des requêtes SMS dans les logs et de téléchargement du dernier log",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^7.2",
        "laravel/lumen-framework": "^6.0"
    },
    "require-dev": {
        "fzaninotto/faker": "^1.4",
        "phpunit/phpunit": "^8.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": { "php": "7.2.34" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
